{
  "name": "your-procedure-is-denied-build",
  "private": true,
  "version": "0.0.0",
  "description": "Hackathon work: appeal-drafting proposer on Meta models behind the LITMUS verifier",
  "type": "module",
  "scripts": {
    "test-call": "node --env-file=../.env --import tsx src/test-call.ts",
    "probe": "node --env-file=../.env --import tsx src/probe.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --env-file=../.env --import tsx src/smoke.ts",
    "synthetic": "node --import tsx src/synthetic/generate.ts",
    "harness": "node --env-file=../.env --import tsx src/harness.ts",
    "viewer": "node --import tsx scripts/build-viewer.ts && tsc -p viewer/tsconfig.json",
    "viewer:serve": "python3 -m http.server 8787 --directory viewer",
    "advise": "node --env-file=../.env --import tsx scripts/advise.ts",
    "regate": "node --import tsx scripts/regate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
